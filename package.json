{
  "name": "es-arena",
  "productName": "ES Arena",
  "version": "0.4.4",
  "private": true,
  "description": "A Three.js remake of The Elder Scrolls: Arena that loads the player's own game files.",
  "author": "arenasloppa",
  "homepage": "https://github.com/arenasloppa/ES-Arena",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arenasloppa/ES-Arena.git"
  },
  "build": {
    "appId": "io.github.arenasloppa.es-arena",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "electronLanguages": [
      "en",
      "en-US",
      "en-GB"
    ],
    "artifactName": "ES-Arena-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "mac": {
      "target": "zip",
      "category": "public.app-category.role-playing-games",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": "zip"
    },
    "linux": {
      "target": "dir"
    }
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
